system_ss.add(when: 'CONFIG_ASPEED_SOC', if_true: files('wdt_aspeed.cpp'))
system_ss.add(when: 'CONFIG_WDT_IMX2', if_true: files('wdt_imx2.cpp'))
system_ss.add(when: 'CONFIG_WDT_SBSA', if_true: files('sbsa_gwdt.cpp'))
