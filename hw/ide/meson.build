system_ss.add(when: 'CONFIG_AHCI', if_true: files('ahci.cpp'))
system_ss.add(when: 'CONFIG_AHCI_ICH9', if_true: files('ich.cpp'))
system_ss.add(when: 'CONFIG_AHCI_SYSBUS', if_true: files('ahci-sysbus.cpp'))
system_ss.add(when: 'CONFIG_ALLWINNER_A10', if_true: files('ahci-allwinner.cpp'))
system_ss.add(when: 'CONFIG_IDE_BUS', if_true: files('ide-bus.cpp'))
system_ss.add(when: 'CONFIG_IDE_CF', if_true: files('cf.cpp'))
system_ss.add(when: 'CONFIG_IDE_CMD646', if_true: files('cmd646.cpp'))
system_ss.add(when: 'CONFIG_IDE_CORE', if_true: files('core.c', 'atapi.c'))
system_ss.add(when: 'CONFIG_IDE_DEV', if_true: files('ide-dev.cpp'))
system_ss.add(when: 'CONFIG_IDE_ISA', if_true: files('isa.cpp', 'ioport.cpp'))
system_ss.add(when: 'CONFIG_IDE_MACIO', if_true: files('macio.cpp'))
system_ss.add(when: 'CONFIG_IDE_MMIO', if_true: files('mmio.cpp'))
system_ss.add(when: 'CONFIG_IDE_PCI', if_true: files('pci.cpp'))
system_ss.add(when: 'CONFIG_IDE_PIIX', if_true: files('piix.cpp', 'ioport.cpp'))
system_ss.add(when: 'CONFIG_IDE_SII3112', if_true: files('sii3112.cpp'))
system_ss.add(when: 'CONFIG_IDE_VIA', if_true: files('via.cpp'))
